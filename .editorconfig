# ==============================================================================
# Stratocraft — Ortak Kodlama Stili (.editorconfig)
# ==============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.{json,yml,yaml,toml,asmdef}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_style_var_for_built_in_types = false:suggestion

[*.{cpp,h,hpp}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 110
