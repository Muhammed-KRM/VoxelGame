<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\_Stratocraft\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Stratocraft\Voxel\**\*.cs" Link="Voxel\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Stratocraft\Physics\**\*.cs" Link="Physics\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Stratocraft\WorldGen\**\*.cs" Link="WorldGen\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Stratocraft\Networking\LiteNetLibVoxelStreamer.cs" Link="Networking\LiteNetLibVoxelStreamer.cs" />
    <Compile Include="..\..\Assets\_Stratocraft\Character\**\*.cs" Link="Character\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Stratocraft\Inventory\**\*.cs" Link="Inventory\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Stratocraft\CreaturesAI\**\*.cs" Link="CreaturesAI\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\_Stratocraft\UI\**\*.cs" Exclude="..\..\Assets\_Stratocraft\UI\F3TelemetryOverlayUi.cs" Link="UI\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Tests\EditMode\**\*.cs" Link="EditMode\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Tests\PlayMode\**\*.cs" Link="PlayMode\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Assets\Plugins\x86_64\StratocraftNative.dll"
          Link="StratocraftNative.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
